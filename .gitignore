# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / pnpm ---
node_modules/
ui/**/dist/
ui/tokens/dist/
.pnpm-store/
*.tsbuildinfo

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
# real dbt profile must never be committed (secrets)
dbt/profiles/profiles.yml
profiles.yml

# --- Terraform ---
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/terraform/backend.tf
crash.log

# --- Secrets / creds (never commit) ---
*.key
*-key.json
service-account*.json
.env
.env.*
!.env.example

# --- Per-tenant key files (Story 7.3 -- key material NEVER in git) ---
infra/keys/
!infra/keys/.gitkeep

# --- Story 1.4 generated artifacts (seeds) ---
# These are generated at dev/CI time; never committed. La regle vaut pour TOUT
# module : chaque seeds/ porte son generate_*_seed.py, qui EST la source ; le CSV
# est sa sortie. Verifie le 2026-08-01 : aucun CSV de server/modules/*/seeds/
# n'etait suivi, et neuf trainaient en non-suivis a chaque git status.
# NB : cette regle est volontairement ancree sur server/modules/. Un
# `*/seeds/*.csv` non qualifie avalerait les 19 CSV de dbt/seeds/ (dim_country,
# fx_rates, dim_metric...), qui sont eux de la donnee de reference committee.
server/modules/*/seeds/*.csv
server/modules/google-analytics/seeds/local.duckdb
server/modules/google-analytics/seeds/*.duckdb

# --- Local diagnostic/scratch artifacts ---
server/core/scratch_*

# Repertoires temporaires d'agent (pytest tmp_path roots, builds dbt de sonde,
# duckdb jetables). Le suffixe est un numero de tache, jamais le meme deux fois :
# sans cette ligne chaque campagne laisse des centaines d'entrees non suivies
# dans `git status`, et c'est la qu'un `git add -A` en emporte une.
.task-tmp-*/

# Bac a sable de session : sondes, captures, dumps JSON de traduction. Rien de
# ce qui compte ne vit ici -- ce qui compte part en commit. Une exception, un
# script reellement partage qui y a ete pose avant cette regle.
scratch/
!scratch/push_all_docs_repos.py

# Sorties d'audit datees (conformance, ledger) -- l'instrument les regenere.
reports/

# Couverture pytest -- artefact de run.
.coverage
.coverage.*

# --- design-sync (claude.ai/design) — staged scripts + build output; durable state
# (design-sync.config.json, .design-sync/NOTES.md|previews/|overrides/) IS committed ---
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/

# Le site marketing web/ fait partie du monorepo (zone privee, cf.
# docs/project-context.md "Repository model" + distribution/public-app.toml:
# web est dans private_paths, jamais exporte dans l'app publique).
# L'ancien .git imbriqué (scaffolding Astro) a ete absorbe le 2026-07-19
# (historique sauvegarde en bundle) -- on n'ignore que sa sauvegarde locale.
web/.git-absorbed-*.bak/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Enrichment snapshots (Supermetrics) are fetch artifacts -- never committed (playbook section 2)
server/modules/*/catalog_sources/supermetrics.md

# Local DuckDB seed/build artifacts -- never committed (local test material)
server/modules/*/seeds/*.duckdb

# Firebase Hosting deploy cache -- local artifact, never committed.
# The rule covers EVERY deploy target: `web/` was named alone, so
# `ui/admin/.firebase/` stayed tracked and came back dirty after each deploy.
.firebase/

# Codex parallel-session scratch (audit scripts, backups, JSON dumps) -- never committed
.codex-tmp/

# Stray local test screenshots at repo root -- never committed
/test_*.png

# Journey-gate screenshots (e2e/runner.py) -- 18 MB of PNGs per campaign, never
# committed. The run reports next door (_bmad-output/qa/runs/*.json) ARE committed:
# they are the dated evidence a gate result rests on, and they stay small.
_bmad-output/qa/screenshots/
# Walk captures carry real org/project slugs in their file names: never in the repo.
_bmad-output/qa/walks/

# Harness chain pins (e2e/arm_harness_project.py -> e2e/chain_pins.py) -- a LOCAL
# file naming this deployment's own project, feed, host and service accounts. Never
# committed: those are production identifiers (CLAUDE.md, "Jamais").
_bmad-output/qa/pins/

# Visual-QA artifacts (Playwright route-mock harnesses + screenshots) -- never committed
/*qa.mjs
/test-results/
ui/admin/shot-*.png
ui/admin/qa-*.png
ui/admin/dk-*.png
ui/admin/lv-*.png
ui/admin/lw-*.png
ui/admin/live-*.png
