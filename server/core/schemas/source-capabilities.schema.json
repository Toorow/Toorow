{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toorow.dev/schemas/source-capabilities.schema.json",
  "title": "Toorow Source Capabilities",
  "description": "Canonical contract for connector report capabilities and their scoped public representation.",
  "$defs": {
    "field_discovery": {
      "type": "object",
      "required": ["mode", "allowed_targets"],
      "properties": {
        "mode": {"type": "string", "enum": ["static", "runtime"]},
        "allowed_targets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "field_id",
        "source_field",
        "kind",
        "physical_type",
        "description",
        "semantic_hints",
        "canonical_target",
        "aggregation",
        "non_additive"
      ],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "source_field": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["metric", "dimension", "event"]},
        "physical_type": {
          "type": "string",
          "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "json"]
        },
        "description": {"type": "string", "minLength": 1},
        "semantic_hints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "canonical_target": {"type": ["string", "null"]},
        "aggregation": {
          "type": "string",
          "enum": ["sum", "average", "impression_weighted", "max", "latest", "none"]
        },
        "non_additive": {"type": "boolean"},
        "label_source_field": {
          "type": ["string", "null"],
          "description": "Epic 31: for kind='event' only -- the provider source field carrying the human LABEL of the event instance (level 3 of platform>type>label). Null/absent for metric/dimension fields. An event field sets aggregation='none', non_additive=false (both N/A for a temporal marker)."
        },
        "derivation": {
          "type": ["object", "null"],
          "description": "CALCULATED/DERIVED metric (kind='metric' only). The metric EXISTS in the provider API (declared here for catalogue completeness) but its provider-computed value is NOT trusted as an additive fact -- it is RECONSTRUCTED downstream from additive components. Implies non_additive=true. 'imported' selects the flavour: false (default) = provider value DROPPED at import and recomputed from components; true = provider value ALSO landed raw as a non-additive column for parity/audit, never summed. Declaring the reconstruction here lets the semantic/mart layer generate it instead of hardcoding it per connector.",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {"type": "string", "enum": ["ratio", "expression"]},
            "numerator": {"type": ["string", "null"], "description": "canonical_target of the additive numerator (method='ratio')"},
            "denominator": {"type": ["string", "null"], "description": "canonical_target of the additive denominator (method='ratio')"},
            "scale": {"type": ["number", "null"], "description": "multiplier applied after division: 1000 for eCPM/CPM (per mille), 100 for a percentage, 1/absent otherwise"},
            "expression": {"type": ["string", "null"], "description": "free-form recomputation over canonical fields (method='expression'), e.g. 'clicks / impressions'"},
            "imported": {"type": "boolean", "description": "false (default) = provider value dropped at import and reconstructed downstream; true = also landed raw as a non-additive column for parity, never summed"}
          }
        },
        "money": {
          "type": ["object", "null"],
          "description": "Story 39.2: money adapter INPUT contract (kind='metric' monetary field). Declares the connector's NATIVE money encoding. The platform adapter (server/core/money.py) normalizes this to the ONE canonical internal unit = micros, currency attached (E39-AD1); the /1e6 division back to display units happens ONCE at read. Absent => not a monetary field (39.1's monetary classification is the governed set; this adds the orthogonal native-encoding axis). ADDITIVE / backward-compatible: absent = today's behaviour.",
          "additionalProperties": false,
          "required": ["native_unit"],
          "properties": {
            "native_unit": {"type": "string", "enum": ["micros", "decimal", "cents"]},
            "currency_source": {"type": ["string", "null"], "description": "Opaque locus of the source currency (e.g. a field id or 'network'); the ADAPTER reads it, core never names a provider (AD-2)."}
          }
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["selectable", "unavailable"]},
        "reason_code": {"type": ["string", "null"]},
        "follow_up": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "unavailable"}},
            "required": ["status"]
          },
          "then": {
            "required": ["reason_code", "follow_up"],
            "properties": {
              "reason_code": {"type": "string", "minLength": 1},
              "follow_up": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "reason_code": {"type": "null"},
              "follow_up": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "required": ["callable"],
      "properties": {
        "callable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      },
      "additionalProperties": false
    },
    "alternative": {
      "type": "object",
      "required": ["metrics", "dimensions"],
      "properties": {
        "metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "suggested_repair": {
      "type": "object",
      "required": ["remove_fields", "add_fields", "split_into_reports"],
      "properties": {
        "remove_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "add_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "split_into_reports": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
        "minimum_interval_minutes": {"type": "integer", "minimum": 1},
        "supported_modes": {
          "type": "array",
          "items": {"type": "string", "enum": ["manual", "hourly", "daily", "weekly"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_grains": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 1
        },
        "supported_filter_operators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["eq", "neq", "in", "not_in", "gt", "gte", "lt", "lte", "contains"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "anyOf": [
        {"properties": {"remove_fields": {"minItems": 1}}},
        {"properties": {"add_fields": {"minItems": 1}}},
        {"properties": {"split_into_reports": {"minItems": 1}}},
        {"required": ["minimum_interval_minutes"]},
        {"required": ["supported_modes"]},
        {"required": ["supported_grains"]},
        {"required": ["supported_filter_operators"]}
      ],
      "additionalProperties": false
    },
    "compatibility_constraint": {
      "type": "object",
      "required": [
        "reason_code",
        "description",
        "constraint",
        "field_ids",
        "supported_alternatives",
        "suggested_repair"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "unknown_report_field",
            "incompatible_report_fields",
            "unsupported_grain",
            "unsupported_filter",
            "unsupported_cadence"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "constraint": {
          "type": "string",
          "enum": ["requires_all", "incompatible_with", "allowed_grains", "limit"]
        },
        "field_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_alternatives": {
          "type": "array",
          "items": {"$ref": "#/$defs/alternative"}
        },
        "suggested_repair": {"$ref": "#/$defs/suggested_repair"}
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "required": ["field_id", "operators"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "operators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["eq", "neq", "in", "not_in", "gt", "gte", "lt", "lte", "contains"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "pagination": {
      "type": "object",
      "required": ["mode", "completeness", "max_pages", "row_limit", "truncation_signal"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "offset", "cursor", "page", "link"]},
        "completeness": {"type": "string", "enum": ["complete", "bounded", "hard_limit", "top_n", "unknown"]},
        "max_pages": {"type": ["integer", "null"], "minimum": 1},
        "row_limit": {"type": ["integer", "null"], "minimum": 1},
        "truncation_signal": {"type": "string", "enum": ["explicit", "logged", "none", "unknown"]}
      },
      "additionalProperties": false
    },
    "quota_cost": {
      "type": "object",
      "required": ["read_points", "unit"],
      "properties": {
        "read_points": {"type": "integer", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "incremental": {
      "type": "object",
      "required": ["mode", "cursor_field"],
      "properties": {
        "mode": {"type": "string", "enum": ["full_refresh", "date_window", "cursor"]},
        "cursor_field": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "required": ["minimum_interval_minutes", "supported_modes"],
      "properties": {
        "minimum_interval_minutes": {"type": "integer", "minimum": 1},
        "supported_modes": {
          "type": "array",
          "items": {"type": "string", "enum": ["manual", "hourly", "daily", "weekly"]},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": [
        "id",
        "selection_mode",
        "availability",
        "metrics",
        "dimensions",
        "supported_grains",
        "compatibility",
        "filters",
        "pagination",
        "quota_cost",
        "incremental",
        "cadence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selection_mode": {"type": "string", "enum": ["exact_bundle", "subset", "catalog_driven"]},
        "availability": {"$ref": "#/$defs/availability"},
        "dispatch": {"$ref": "#/$defs/dispatch"},
        "landing": {
          "type": "string",
          "enum": ["fact_daily_kpi", "context_events"],
          "description": "Epic 31: where this profile's pull lands. Absent = derived at load (module_kind=='context' -> context_events, else fact_daily_kpi). A connector may mix landings across profiles (e.g. YouTube kpi profiles + a video_upload event profile), so 'landing' -- not module_kind -- decides the write path and the conformance layer."
        },
        "metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "events": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "description": "Epic 31: for a landing='context_events' profile -- the kind='event' field ids this profile emits (metrics/dimensions stay empty). A kpi profile leaves this empty/absent."
        },
        "supported_grains": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "compatibility": {"type": "array", "items": {"$ref": "#/$defs/compatibility_constraint"}},
        "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "pagination": {"$ref": "#/$defs/pagination"},
        "quota_cost": {"$ref": "#/$defs/quota_cost"},
        "incremental": {"$ref": "#/$defs/incremental"},
        "cadence": {"$ref": "#/$defs/cadence"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "properties": {"status": {"const": "selectable"}},
                "required": ["status"]
              }
            }
          },
          "then": {"required": ["dispatch"]}
        }
      ],
      "additionalProperties": false
    },
    "time_context": {
      "type": ["object", "null"],
      "description": "Story 39.7: report-timezone CAPTURE contract INPUT (DESCRIPTOR level -- one report timezone per datastream/network/property, contrast 39.2's per-field money). Declares WHERE this connector reads the exact report timezone the source used to draw its reporting-day boundaries, and its fallback posture when it cannot be determined. The platform (server/core/report_timezone.py) validates the captured IANA zone and, when absent, emits a typed TIMEZONE_GAP or records the declared assumption as TAGGED provenance -- NEVER a silent UTC/default (E39-NFR02). Source-agnostic: 'locus' names an ABSTRACT source of the zone, never a provider field (AD-2). Absent => connector captures no report timezone yet (treated as locus='none': a TIMEZONE_GAP for its date-grain figures). ADDITIVE / backward-compatible.",
      "additionalProperties": false,
      "required": ["locus", "fallback"],
      "properties": {
        "locus": {
          "type": "string",
          "enum": ["network", "property", "account", "fixed", "none"],
          "description": "Abstract source of the report timezone: 'network'/'property'/'account' = read from provider metadata at pull; 'fixed' = the provider always reports in one declared zone (see fixed_zone); 'none' = the provider exposes no report timezone (=> TIMEZONE_GAP)."
        },
        "fallback": {
          "type": "string",
          "enum": ["gap", "assume"],
          "description": "Posture when the zone cannot be determined at pull: 'gap' = refuse to assume, surface TIMEZONE_GAP (fail-closed, the default posture); 'assume' = record an explicitly-declared assumed_zone as a TAGGED assumption in provenance (never silent) -- requires assumed_zone."
        },
        "fixed_zone": {"type": ["string", "null"], "description": "IANA zone when locus='fixed' (the one zone the provider always reports in). Null otherwise."},
        "assumed_zone": {"type": ["string", "null"], "description": "IANA zone recorded as a TAGGED assumption when fallback='assume' and the live zone is undetermined. Null when fallback='gap'."}
      },
      "allOf": [
        {
          "if": {
            "properties": {"locus": {"const": "fixed"}},
            "required": ["locus"]
          },
          "then": {
            "required": ["fixed_zone"],
            "properties": {"fixed_zone": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {
            "properties": {"fallback": {"const": "assume"}},
            "required": ["fallback"]
          },
          "then": {
            "required": ["assumed_zone"],
            "properties": {"assumed_zone": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "report_timezone_lever": {
      "type": ["object", "null"],
      "description": "Story 39.8: declares whether THIS source exposes a report-timezone setting in its dimension filters (RARE). Present => the user can change the reporting timezone at the source, and the cross-source day-offset SIGNAL points them there; absent/null => the timezone is fixed on the detected value (no lever) and the datastream is reported as 'fixed on the detected timezone, no lever available'. This is the ADJUSTMENT-LEVER axis, orthogonal to time_context's CAPTURE axis (39.7). GAM has no lever (its timezone is a fixed NETWORK property, not a report filter) => it declares nothing here (has_lever:false). Core NEVER names a provider (AD-2): the connector declares the lever locus OPAQUELY, surfaced verbatim to the user as lever_hint, never interpreted by core. ADDITIVE / backward-compatible: absent = today's behaviour (no lever).",
      "additionalProperties": false,
      "required": ["locus"],
      "properties": {
        "locus": {"type": "string", "minLength": 1, "description": "Opaque hint WHERE the report-timezone setting lives at the source (e.g. a filter id or 'report_settings'); surfaced verbatim to the user as lever_hint, never interpreted by core (AD-2)."}
      }
    },
    "descriptor": {
      "type": "object",
      "required": ["contract_version", "field_discovery", "fields", "reports"],
      "properties": {
        "contract_version": {"const": "1"},
        "field_discovery": {"$ref": "#/$defs/field_discovery"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}, "minItems": 1},
        "time_context": {"$ref": "#/$defs/time_context"},
        "report_timezone_lever": {"$ref": "#/$defs/report_timezone_lever"}
      },
      "additionalProperties": false
    },
    "public_response": {
      "type": "object",
      "required": [
        "contract_version",
        "project_id",
        "connection_ref_id",
        "module",
        "field_discovery",
        "fields",
        "reports"
      ],
      "properties": {
        "contract_version": {"const": "1"},
        "project_id": {"type": "string", "minLength": 1},
        "connection_ref_id": {"type": "string", "minLength": 1},
        "module": {
          "type": "object",
          "required": ["name", "display_name", "module_kind"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "display_name": {"type": "string", "minLength": 1},
            "module_kind": {"type": "string", "enum": ["kpi", "context"]}
          },
          "additionalProperties": false
        },
        "field_discovery": {"$ref": "#/$defs/field_discovery"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}, "minItems": 1},
        "time_context": {"$ref": "#/$defs/time_context"},
        "report_timezone_lever": {"$ref": "#/$defs/report_timezone_lever"}
      },
      "additionalProperties": false
    }
  }
}
