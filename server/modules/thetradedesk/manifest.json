        "AdGroupId": "ad_group_id",
        "CreativeId": "creative_id"
    },
    "quota": {
        "window_seconds": 60,
        "budget_points": 20,
        "read_cost": 1,
        "write_cost": 3,
        "_note": "No published rate limits (dossier section 6): throttling is dynamic and UNDOCUMENTED per partner/advertiser with no published Retry-After. This CONSERVATIVE local budget (20 points/min, report creation = write cost 3) keeps the breaker ahead of the undocumented governor; real limits are probe-only evidence (ROLLOUT_NOTES.md)."
    },
