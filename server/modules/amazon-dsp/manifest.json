    "selection_level": "advertiser",
    "discovery": {
      "callable": "discover_accounts"
    },
    "pull_parameter": "advertiser_id",
    "_pull_parameter_note": "La valeur est l'identifiant ROUTE minte par discover_accounts ('<region>:<adsAccountId>:<advertiserId>') : un appel DSP Reporting v3 exige l'hote regional, l'en-tete Amazon-Ads-AccountId ET l'advertiser, alors que le coeur ne persiste qu'une chaine. Meme convention composite que le connecteur frere amazon-ads.",
    "selection": {
      "required": true,
      "opaque": true
    }
  },
