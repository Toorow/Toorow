  "provider_api_base": "https://advertising-api.amazon.com",
  "_provider_api_note": "Standalone Amazon DSP module. Reporting v3 requests require Amazon-Ads-AccountId and never use Sponsored Ads profile scope.",
  "auth": {
    "type": "oauth2",
    "auth_path": "nango",
    "scope": "advertising::campaign_management",
    "required_headers": [
      "Amazon-Ads-ClientId",
      "Amazon-Ads-AccountId"
    ]
  },
