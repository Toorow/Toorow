        "quota_cost": {"read_points": 1, "unit": "request"}, "incremental": {"mode": "date_window", "cursor_field": null},
        "cadence": {"minimum_interval_minutes": 1440, "supported_modes": ["manual", "daily"]}, "dispatch": {"callable": "pull_youtube_compatible"}
      }
    ]
  }
