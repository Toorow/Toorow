        "supported_grains": [["date", "advertiser_id", "campaign_id", "insertion_order_id", "line_item_id", "creative_id"]],
        "compatibility": [], "filters": [{"field_id": "date", "operators": ["gte", "lte"]}],
        "pagination": {"mode": "link", "completeness": "complete", "max_pages": null, "row_limit": null, "truncation_signal": "none"},
        "quota_cost": {"read_points": 1, "unit": "request"}, "incremental": {"mode": "date_window", "cursor_field": null},
