  "display_name": "Display & Video 360",
  "business_domain": "marketing",
  "public_catalog": {
    "visibility": "public",
    "category": "paid_media",
    "onboarding_modes": [
      "connector_pull"
    ],
    "verification": {
      "status": "blocked",
      "reason_code": "live_evidence_not_ratified",
      "follow_up": "Probe an authorized DV360 partner and advertiser across discovery, two report families, saved-query reuse, GCS download, types, currency, timezone and errors."
    }
  },
  "auth_type": "google_direct",
  "module_kind": "kpi",
  "provider_api_version": "display-video-v4+bid-manager-v2",
  "provider_api_base": "https://displayvideo.googleapis.com/v4",
  "_provider_api_note": "Display Video API v4 is pinned for read-only discovery; Bid Manager v2 is independently pinned for asynchronous reporting. No v3 endpoint is used.",
  "auth": {
    "type": "google_direct",
    "auth_path": "google_direct",
    "scope": "https://www.googleapis.com/auth/display-video"
  },
  "account_topology": {
    "_comment": "Story 25.7 / conformance test_pull_contract: the reporting entity is the ADVERTISER and it is the only identifier the Bid Manager query needs (filters: FILTER_ADVERTISER). partner_id is provenance, not routing -- it is a column of raw_dv360_daily -- so discover_accounts mints the composite opaque id '<advertiser_id>@<partner_id>' to keep it, and a bare advertiser id is accepted with an empty partner rather than refused. Core never interprets the id (AD-2). Env-var account fallbacks are FORBIDDEN: one variable per deployment would pull the same advertiser for every project.",
    "levels": [
      {
        "id": "partner",
        "label": "Partner"
      },
      {
        "id": "advertiser",
        "label": "Advertiser"
      }
    ],
    "selection_level": "advertiser",
    "discovery": {
      "callable": "discover_accounts"
    },
    "pull_parameter": "advertiser_id",
    "selection": {
      "required": true,
      "opaque": true
    },
    "operating_context": {
      "parameters": {
        "partner_id": "partner"
      },
      "_note": "DV360 identifie l'annonceur SOUS son partenaire ; la feuille seule ne suffit pas. Le coeur ne connait aucun nom de niveau (AD-2) : ce mapping dit quel niveau du `selection_path` alimente quel parametre de `pull()`."
    }
  },
