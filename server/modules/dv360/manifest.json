  "error_map": {
    "401:UNAUTHENTICATED": "auth_expired",
    "403:PERMISSION_DENIED": "permission_denied",
    "400:INVALID_ARGUMENT": "invalid_request",
    "404:NOT_FOUND": "invalid_request",
    "409:ABORTED": "provider_transient"
  },
  "_error_map_note": "429 and the RESOURCE_EXHAUSTED reason carry NO error_map entry on purpose: _raise_response intercepts both before classify_http_error is ever reached and raises core.quota.RateLimitError, which is the breaker path (retry_after honoured, no reclassification). A '429:RESOURCE_EXHAUSTED' key used to sit in the map above -- unreachable code in data form, which read as coverage while covering nothing.",
  "quota": {
    "window_seconds": 60,
    "budget_points": 240,
    "read_cost": 1,
    "write_cost": 1
  },
  "_quota_note": "Bid Manager uses 4 QPS/project, 240 requests/minute/user and 2000/day/project. Discovery v4 is charged separately at 1500/minute/project and 300/minute/advertiser; runtime only performs reads.",
