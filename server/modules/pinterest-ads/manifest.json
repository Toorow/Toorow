    "account_topology": {
        "_comment": "Story 26.3 (pattern 25.5 / meta-ads): Pinterest reporting topology is a single flat level -- the token's reachable ad accounts (GET /ad_accounts, bookmark-paginated, include_shared_accounts=true covers Business Access shares). The selected reporting entity is the AD ACCOUNT. Access check = 1-day tier-core sync analytics probe on the selected account (Owner or Business Access Admin/Analyst/Campaign Manager role required). PINTEREST_ADS_*_ID env vars are FORBIDDEN (doctrine); selection/access-check/trial/backfill are the core topology flows.",
        "levels": [
            {
                "id": "ad_account",
                "label": "Ad account"
            }
        ],
        "selection_level": "ad_account",
        "discovery": {
            "callable": "discover_accounts"
        }
