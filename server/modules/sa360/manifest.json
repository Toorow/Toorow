  "canonical_dimension_mapping": {
    "segments.date": "date", "customer.id": "customer_id", "campaign.id": "campaign_id", "adGroup.id": "ad_group_id", "adGroupCriterion.criterionId": "criterion_id", "segments.device": "device", "customer.currencyCode": "currency_code"
  },
  "error_map": {
    "401:UNAUTHENTICATED": "auth_expired", "403:PERMISSION_DENIED": "permission_denied", "400:INVALID_ARGUMENT": "invalid_request", "400:INVALID_PAGE_SIZE": "invalid_request", "400:FILTER_HAS_TOO_MANY_VALUES": "invalid_request", "404:NOT_FOUND": "invalid_request", "500:INTERNAL": "provider_transient", "503:UNAVAILABLE": "provider_transient"
  },
  "quota": {"window_seconds": 60, "budget_points": 3000, "read_cost": 1, "write_cost": 1,
    "_validation_required": "message_too_large_429_shape: the Sa360MessageTooLargeError heuristic matches substrings ('message larger', '4 mb', 'received message larger') in the JSON-serialized 429 body. The exact gRPC 4 MB transport-limit error shape is unconfirmed against a live response; if the provider encodes it differently (grpc-message header or another key) it would fall through to RateLimitError. Confirm during the live probe."},
  "_quota_note": "3000 queries/minute/project/user, 3000/minute/project and 150000/day/project. Follow-up Search pages are not recharged; maximum page size 10000 and IN list 20000.",
