      {"field_id": "customer.currencyCode", "source_field": "customer.currencyCode", "kind": "dimension", "physical_type": "string", "description": "Customer currency code.", "semantic_hints": ["currency"], "canonical_target": "currency_code", "aggregation": "none", "non_additive": false},
      {"field_id": "metrics.impressions", "source_field": "metrics.impressions", "kind": "metric", "physical_type": "integer", "description": "Recorded impressions.", "semantic_hints": ["delivery"], "canonical_target": "impressions", "aggregation": "sum", "non_additive": false},
      {"field_id": "metrics.clicks", "source_field": "metrics.clicks", "kind": "metric", "physical_type": "integer", "description": "Recorded clicks.", "semantic_hints": ["delivery"], "canonical_target": "clicks", "aggregation": "sum", "non_additive": false},
      {"field_id": "metrics.cost_micros", "source_field": "metrics.costMicros", "kind": "metric", "physical_type": "integer", "description": "Cost in customer-currency micros.", "semantic_hints": ["cost", "currency", "micros"], "canonical_target": "cost", "aggregation": "sum", "non_additive": false},
      {"field_id": "metrics.conversions", "source_field": "metrics.conversions", "kind": "metric", "physical_type": "decimal", "description": "Attributed conversions.", "semantic_hints": ["conversion"], "canonical_target": "conversions", "aggregation": "sum", "non_additive": false},
      {"field_id": "metrics.conversions_value", "source_field": "metrics.conversionsValue", "kind": "metric", "physical_type": "decimal", "description": "Attributed conversion value.", "semantic_hints": ["conversion", "currency"], "canonical_target": "conversions_value", "aggregation": "sum", "non_additive": false},
      {"field_id": "metrics.average_cpc_micros", "source_field": "metrics.averageCpcMicros", "kind": "metric", "physical_type": "integer", "description": "Average CPC in micros.", "semantic_hints": ["average", "non_additive", "micros"], "canonical_target": "average_cpc", "aggregation": "impression_weighted", "non_additive": true},
