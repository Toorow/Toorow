{
  "schema_version": "1.2",
  "name": "sa360",
  "display_name": "Search Ads 360",
  "public_catalog": {
    "visibility": "public",
    "category": "paid_media",
    "onboarding_modes": ["connector_pull"],
    "verification": {
      "status": "blocked",
      "reason_code": "live_evidence_not_ratified",
      "follow_up": "Probe an authorized SA360 direct or manager-routed client across discovery, Search, SearchStream, compatibility, physical types and errors."
    }
  },
  "auth_type": "google_direct",
  "module_kind": "kpi",
  "provider_api_version": "search-ads-360-reporting-v0",
  "provider_api_base": "https://searchads360.googleapis.com/v0",
  "_provider_api_note": "Read-only Search Ads 360 Reporting API v0. Search handles bounded pages and SearchStream handles expected result sets above 10000 rows.",
  "auth": {"type": "google_direct", "auth_path": "google_direct", "scope": "https://www.googleapis.com/auth/doubleclicksearch"},
  "account_topology": {
    "levels": ["accessible_customer", "manager_login_customer", "client_customer"],
    "selection_level": "client_customer",
    "discovery": {"callable": "discover_accounts"},
    "selection": {"required": true, "opaque": true},
    "backfill_window_days": 30,
    "_backfill_window_note": "SA360 default conversion attribution window is 30 days; pulling less than 30 days back risks under-counting late-attributed conversions. The Reporting API v0 has no hard backfill ceiling, so 30 days is a policy floor, not a technical limit."
  },
  "report_profiles": [
    {"id": "campaign_daily", "display_name": "Campaign performance (daily)", "metrics": ["metrics.impressions", "metrics.clicks", "metrics.cost_micros", "metrics.conversions"], "dimensions": ["segments.date", "customer.id", "campaign.id", "segments.device"], "extraction_capabilities": {"row_limit": null, "filters_supported": true, "realtime": false}, "extraction_path": "custom_pull"},
    {"id": "ad_group_daily", "display_name": "Ad group performance (daily)", "metrics": ["metrics.impressions", "metrics.clicks", "metrics.cost_micros", "metrics.conversions"], "dimensions": ["segments.date", "customer.id", "campaign.id", "adGroup.id", "segments.device"], "extraction_capabilities": {"row_limit": null, "filters_supported": true, "realtime": false}, "extraction_path": "custom_pull"},
    {"id": "keyword_daily", "display_name": "Keyword performance (daily)", "metrics": ["metrics.impressions", "metrics.clicks", "metrics.cost_micros", "metrics.conversions", "metrics.search_impression_share"], "dimensions": ["segments.date", "customer.id", "campaign.id", "adGroup.id", "adGroupCriterion.criterionId", "segments.device"], "extraction_capabilities": {"row_limit": null, "filters_supported": true, "realtime": false}, "extraction_path": "custom_pull"},
    {"id": "catalog_daily", "display_name": "Explicit compatible SA360 fields", "metrics": ["metrics.impressions", "metrics.clicks"], "dimensions": ["segments.date", "customer.id", "campaign.id"], "extraction_capabilities": {"row_limit": 10000, "filters_supported": true, "realtime": false}, "extraction_path": "custom_pull"}
  ],
  "canonical_metric_mapping": {
    "metrics.impressions": "impressions",
    "metrics.clicks": "clicks",
    "metrics.cost_micros": "cost",
    "metrics.conversions": "conversions",
    "metrics.conversions_value": "conversions_value",
    "metrics.average_cpc_micros": {"canonical": "average_cpc", "aggregation_rule": "impression_weighted", "non_additive": true},
    "metrics.search_impression_share": {"canonical": "search_impression_share", "aggregation_rule": "impression_weighted", "non_additive": true},
    "metrics.click_through_rate": {"canonical": "click_through_rate", "aggregation_rule": "impression_weighted", "non_additive": true}
