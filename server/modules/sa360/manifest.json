      {"field_id": "customer.id", "source_field": "customer.id", "kind": "dimension", "physical_type": "string", "description": "Client customer identifier.", "semantic_hints": ["customer", "identifier"], "canonical_target": "customer_id", "aggregation": "none", "non_additive": false},
