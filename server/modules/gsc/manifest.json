    "canonical_metric_mapping": {
        "clicks": "clicks",
        "impressions": "impressions",
        "average_position": {
            "canonical": "average_position",
            "aggregation_rule": "impression_weighted",
            "non_additive": true
        }
    },
    "canonical_dimension_mapping": {
        "page": "page",
        "country": "country",
        "device": "device",
        "query": "query",
        "searchAppearance": "search_appearance",
        "search_type": "search_type",
        "hour": "hour"
    },
    "error_map": {},
    "_error_map_note": "Google Search Console uses standard HTTP status codes only (no provider-specific numeric subcodes in the error payload). The pure-HTTP taxonomy in classify_http_error already covers all actionable classes: 401 -> auth_expired, 403 -> permission_denied, 400 -> invalid_request, 5xx -> provider_transient. No provider-code refinements are needed. This was confirmed against https://developers.google.com/webmaster-tools/v1/searchanalytics/query (2026-07-21): the error body shape is a Google API Error object { error: { code, message, errors[] } } with no application-level subcode equivalent to Meta's error.code/subcode.",
    "account_topology": {
        "_comment": "Story 25.7 (AC4): GSC topology is a single flat level — the token's reachable sites (GSC properties). The reporting entity (selection_level) is the SITE (a searchanalytics.query call targets sites/{siteUrl}/searchAnalytics/query). discover_accounts calls the Webmasters API sites.list endpoint to enumerate what the token can access. Core owns selection/access-check/trial/backfill. Replaces the GSC_SITE_URL env-var pattern (deprecated at 25.7 rollout; see ROLLOUT_NOTES.md — existing behaviour not removed, env-var fallback in _resolve_site_url remains functional until core topology is wired).",
        "levels": [
            {
                "id": "site",
                "label": "Site (GSC property)"
            }
        ],
        "selection_level": "site",
        "discovery": {
            "callable": "discover_accounts"
        }
    },
    "quota": {
        "window_seconds": 100,
        "budget_points": 1200,
        "read_cost": 1,
        "write_cost": 1
    },
    "widget_ref": "ui://core/daily-report",
