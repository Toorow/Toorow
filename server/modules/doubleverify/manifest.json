  "error_map": {
    "401": "auth_expired",
    "403": "permission_denied",
    "400": "invalid_request",
    "404": "invalid_request",
    "429": "provider_transient",
    "500": "provider_transient",
    "503": "provider_transient",
    "_error_map_note": "DoubleVerify's Data API error reference is gated behind the developer-portal login, so no enumerated application-level sub-code set is verifiable at authoring time. This map is therefore keyed on HTTP status only; the pure-HTTP taxonomy in core.pull_errors.classify_http_error already resolves the actionable classes (401->auth_expired token/hash invalid, 403->permission_denied Reporting Program not attached, 400->invalid_request bad dimension/metric combination or removed field, 404->invalid_request unknown/expired request id past the 30-day window, 5xx->provider_transient). The one confirmed provider-specific error is the free-text message 'There is a problem with the selected combination of dimensions and/or metrics' returned on an invalid combo (HTTP 400 -> invalid_request), which needs no numeric-code refinement. A future story can add sub-code keying once the portal error reference is accessible in a live pass (AI-13)."
  },
  "_account_topology_note": "DoubleVerify access is scoped by 'Reporting Programs' selected at Access-Token-Hash creation time in DV Pinnacle (Analytics -> Data API -> Create token). One token may cover one or many Reporting Programs, but DV exposes NO endpoint to enumerate the reachable programs or accounts -- advertiser, campaign, placement, media_property are report DIMENSIONS, not list endpoints. There is therefore nothing to discover programmatically: no discover_accounts is implemented and no *_ACCOUNT_ID env var is used. Accounts/advertisers are discovered empirically by selecting advertiser_name / campaign as dimensions in a report and reading the distinct values (the pattern Adverity/Improvado/Supermetrics also use). The token IS the account selector. Source: Supermetrics DoubleVerify connection guide (https://docs.supermetrics.com/docs/doubleverify-connection-guide); DV developer Report Data API.",
  "quota": {
    "window_seconds": 60,
    "budget_points": 60,
    "read_cost": 1,
    "write_cost": 1,
    "_research_notes": "No request/rate limit is published by DoubleVerify or its integration partners ('No documented request limits' -- Supermetrics). Reporting is asynchronous (submit -> poll status -> download CSV), so the implicit throttle is the poll loop rather than a per-second cap. This conservative 60 req/min budget is a placeholder; the real backstop is the 429 -> RateLimitError handler. Recalibrate against live response headers in the live-integration pass (AI-13)."
  },
  "freshness_policy": {
    "earliest_queryable_offset_days": 1,
    "stable_offset_days": 3,
    "refresh_time": "06:00 CST",
    "_research_notes": "DV data refreshes at 06:00 CST and same-day data cannot be pulled (T-1 is the earliest queryable day; T-3 is treated as stable). Media Gardens (social) report families lag further and per-channel and are out of scope for this Standard-report module. Sources: Alli DoubleVerify doc; Salesforce/Datorama DoubleVerify connector ('Data Lagging: 1 Day')."
  },
  "widget_ref": "ui://core/daily-report",
  "_auth_note": "DoubleVerify authenticates with a static, long-lived 'Access Token Hash' minted in the DV Pinnacle UI (there is NO OAuth flow, token endpoint, or refresh). The hash is sent as 'Authorization: Bearer <hash>'. Per AD-3 the secret transits ONLY via Nango (get_fresh_token(connection_id, provider='doubleverify')) and is never stored or logged by this module. Sources: Improvado DoubleVerify doc; Supermetrics DoubleVerify connection guide.",
