{
  "schema_version": "1.2",
  "name": "cm360",
  "display_name": "Campaign Manager 360",
  "public_catalog": {
    "visibility": "public",
    "category": "paid_media",
    "onboarding_modes": [
      "connector_pull"
    ],
    "verification": {
      "status": "blocked",
      "reason_code": "live_evidence_not_ratified",
      "follow_up": "Probe an authorized CM360 profile and advertiser across discovery, bounded query, saved-report resume, compatibility, pagination and errors."
    }
  },
  "auth_type": "google_direct",
  "module_kind": "kpi",
  "provider_api_version": "dfareporting-v5",
  "provider_api_base": "https://dfareporting.googleapis.com/dfareporting/v5",
  "_provider_api_note": "CM360 v5 is pinned here and in the generated source ledger. reportData.query is bounded to 60 seconds; saved reports use core.async_reports for persisted resume and deduplication.",
  "auth": {
    "type": "google_direct",
    "auth_path": "google_direct",
    "scope": "https://www.googleapis.com/auth/dfareporting"
  },
  "account_topology": {
    "levels": [
      "user_profile",
      "account_or_subaccount",
      "advertiser"
    ],
    "selection_level": "advertiser",
    "discovery": {
      "callable": "discover_accounts"
    },
    "selection": {
      "required": true,
      "opaque": true
    }
  },
  "report_profiles": [
    {
      "id": "standard_daily",
      "display_name": "Standard delivery (daily)",
      "metrics": [
        "impressions",
        "clicks",
        "cost"
      ],
      "dimensions": [
        "date",
        "advertiser_id",
        "campaign_id",
        "placement_id",
        "creative_id"
      ],
      "extraction_capabilities": {
        "row_limit": null,
        "filters_supported": true,
        "realtime": false
      },
      "extraction_path": "custom_pull"
    },
    {
      "id": "floodlight_daily",
      "display_name": "Floodlight conversions (daily)",
      "metrics": [
        "conversions",
        "conversion_value"
      ],
      "dimensions": [
        "date",
        "advertiser_id",
        "campaign_id",
        "floodlight_activity_id"
      ],
      "extraction_capabilities": {
        "row_limit": null,
        "filters_supported": true,
        "realtime": false
      },
      "extraction_path": "custom_pull"
    },
    {
      "id": "reach",
      "display_name": "Reach and frequency",
      "metrics": [
        "unique_reach",
        "average_frequency"
      ],
      "dimensions": [
        "date",
        "advertiser_id",
        "campaign_id",
        "country"
      ],
      "extraction_capabilities": {
        "row_limit": null,
        "filters_supported": true,
        "realtime": false
      },
      "extraction_path": "custom_pull"
    },
    {
      "id": "path_to_conversion",
      "display_name": "Path to conversion",
      "metrics": [],
      "dimensions": [
        "date",
        "advertiser_id"
      ],
      "extraction_capabilities": {
        "row_limit": null,
        "filters_supported": false,
        "realtime": false
      },
      "availability": {
        "status": "unavailable",
        "reason_code": "dedicated_grain_required",
        "follow_up": "Implement a dedicated path-to-conversion landing and bounded extraction contract."
      },
      "extraction_path": "custom_pull"
    }
  ],
  "canonical_metric_mapping": {
    "impressions": "impressions",
    "clicks": "clicks",
    "cost": "cost",
    "conversions": "conversions",
    "conversion_value": "conversions_value",
    "unique_reach": {
      "canonical": "unique_reach",
      "aggregation_rule": "max",
      "non_additive": true
    },
    "average_frequency": {
      "canonical": "average_frequency",
      "aggregation_rule": "impression_weighted",
      "non_additive": true
    }
  },
  "canonical_dimension_mapping": {
    "date": "date",
    "advertiser_id": "advertiser_id",
    "campaign_id": "campaign_id",
    "placement_id": "placement_id",
    "creative_id": "creative_id",
    "floodlight_activity_id": "floodlight_activity_id",
    "country": "country"
  },
  "error_map": {
    "401:authError": "auth_expired",
    "403:insufficientPermissions": "permission_denied",
    "403:dailyLimitExceeded": "provider_transient",
    "400:invalid": "invalid_request",
    "404:notFound": "invalid_request",
    "409:conflict": "provider_transient"
  },
  "quota": {
    "window_seconds": 60,
    "budget_points": 120,
    "read_cost": 1,
    "write_cost": 1
  },
