    "error_map": {
        "401:BadAuthentication": "auth_expired",
        "403:UnauthorizedSite": "permission_denied",
        "403:InvalidSpace": "permission_denied",
        "400:InvalidColumns": "invalid_request",
        "400:InvalidJSON": "invalid_request",
        "400:InvalidPeriod": "invalid_request",
        "400:InvalidSort": "invalid_request",
        "400:InvalidFilter": "invalid_request",
        "400:InvalidSegment": "invalid_request",
        "500:UnknownError": "provider_transient"
    },
    "_error_map_note": "Story 28.1 (dossier section 7): keys are '<http_status>:<API_Code_Category>' -- the CATEGORY PREFIX only. Piano v3 error bodies carry an API-Code string (Category_Subcode); connector._code_prefix() reduces it to its Category before matching, so every key here is a bare Category (BadAuthentication, UnauthorizedSite, InvalidSpace, InvalidColumns, ...) -- NEVER a full Category_Subcode (a full-code key would be unreachable). 401 BadAuthentication_* -> auth_expired (rotate/re-enter key). 403 UnauthorizedSite / InvalidSpace_* -> permission_denied (the site access-check signal). 400 InvalidColumns_* is THE dynamic-catalog drift key: an unknown Data Model property/metric key -> invalid_request + pull_invalid_request drift (NOT a crash, NOT a silent drop). 509 QuotasExceeded_TooManyRequests and any 429 stay on the core.quota.RateLimitError breaker path (NOT in this map): serialize per connection + backoff. 5xx fall through to pure-HTTP provider_transient.",
    "refetch": {
        "nightly_days": 3,
        "weekly_days": 14,
        "monthly_days": 30,
        "_note": "Dossier section 6: Piano is near-real-time event-collection analytics that stabilises within ~24h; there is no long conversion-restatement window (contrast google-ads). nightly 3d covers late/queued hits + offline-app sync + short reprocessing; weekly 14d / monthly 30d cover consent/identity reprocessing tails. Per-datastream overridable."
    },
    "canonical_metric_mapping": {
        "m_visits": "visits",
        "m_unique_visitors": "unique_visitors",
        "m_page_loads": "page_loads",
        "m_events": "events"
    },
    "canonical_dimension_mapping": {
        "date": "date",
        "site_id": "site_id",
        "device_type": "device_type",
        "geo_country": "geo_country",
        "src_source": "src_source",
        "src_medium": "src_medium",
        "event_name": "event_name"
    },
    "quota": {
        "window_seconds": 60,
        "budget_points": 60,
        "read_cost": 1,
        "write_cost": 1,
        "_note": "Dossier section 4: Piano publishes NO QPS/points budget -- throttling is on CONCURRENT calls (QuotasExceeded_TooManyRequests HTTP 509). The 60/min budget is a conservative default; the real guard is per-connection serialization (no parallel fan-out) + the 509/429 breaker with backoff."
    },
    "widget_ref": "ui://core/daily-report",
