    "error_map": {},
    "_error_map_note": "IAS Reporting API authentication is OAuth 2.0 (password grant, token endpoint https://api.integralplatform.com/uaa/oauth/token). The one documented application-level error signal is the OAuth 'invalid_token' / 'Access token expired' body returned with HTTP 401 -- which the pure-HTTP taxonomy in classify_http_error already routes to auth_expired (reconnect). The OAuth error body carries a STRING 'error' field (e.g. {\"error\":\"invalid_token\"}), not the numeric error.code/error.subcode shape the generic provider-code extractor reads, so an error_map entry keyed on it could not refine anything the HTTP status does not already give us. IAS does not publish a provider-specific numeric error-code table. Actionable classes are therefore fully covered by status alone: 401 -> auth_expired, 403 -> permission_denied, 400 -> invalid_request, 5xx -> provider_transient, 429 -> RateLimitError. Confirmed against https://helpcenter.integralplatform.com/article/reporting-api (2026-07-21). Revisit if IAS documents numbered error codes.",
    "canonical_metric_mapping": {
        "measuredImps": "measured_impressions",
        "viewableImps": "viewable_impressions",
        "eligibleImps": "eligible_impressions",
        "invalidImps": "invalid_traffic_ads",
        "passedImps": "brand_safety_passed_ads",
        "failedImps": "brand_safety_failed_ads"
    },
    "canonical_dimension_mapping": {
        "campaignId": "campaign_id",
        "campaignName": "campaign_name"
    },
    "account_topology": {
        "_comment": "IAS topology: the reporting entity is the IAS Team (the {teamId} path segment of every /reportingservice/api/teams/{teamId}/... request). A single OAuth credential can reach multiple Teams. discover_accounts enumerates the Teams the token can reach (GET /reportingservice/api/teams -- assumed path, confirmed at live ratification). Core owns selection / access-check / bounded trial / windowed backfill. No IAS_TEAM_ID env var: the selected Team is resolved by core topology and passed to pull at execution.",
        "levels": [
            {
                "id": "team",
                "label": "IAS Team"
            }
        ],
        "selection_level": "team",
        "discovery": {
            "callable": "discover_accounts"
        }
    },
    "quota": {
        "window_seconds": 60,
        "budget_points": 300,
        "read_cost": 1,
        "write_cost": 1
    },
