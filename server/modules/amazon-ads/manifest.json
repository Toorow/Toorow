    "account_topology": {
        "_comment": "Story 26.5 (pattern 25.5): Amazon Ads hierarchy = API region (NA/EU/FE, three ISOLATED hosts) -> advertising profile (one per advertiser x marketplace). The reporting entity (selection_level) is the PROFILE. discover_accounts = fan-out GET /v2/profiles?apiProgram=report&accessLevel=view&profileTypeFilter=seller,vendor over the 3 regional hosts (per-host tolerant: a failing host logs a warning, never fails the whole discovery); every profile node carries the composite opaque id '<REGION>:<profileId>' so every later call routes on the profile's own host without re-discovery (cross-region profileId = 4XX). KDP_AUTHOR sub-type profiles are flagged (no Sponsored Brands access). Core owns selection/access-check/trial/backfill; AMAZON_ADS_*_ID env vars are FORBIDDEN (doctrine).",
        "levels": [
            {
                "id": "region",
                "label": "API region (NA / EU / FE)"
            },
            {
                "id": "profile",
                "label": "Advertising profile (advertiser x marketplace)"
            }
        ],
        "selection_level": "profile",
        "discovery": {
            "callable": "discover_accounts"
        }
    }
