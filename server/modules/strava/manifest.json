                "kind": "dimension",
                "physical_type": "boolean",
                "description": "Stamped by the connector: true for an own club (from discovery), false for a config-supplied competitor club.",
                "semantic_hints": [
                    "flag"
                ],
                "canonical_target": "is_own_club",
                "aggregation": "none",
                "non_additive": false
            }
        ],
        "reports": [
