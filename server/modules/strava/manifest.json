                "aggregation": "none",
                "non_additive": false
            },
            {
                "field_id": "is_verified",
                "source_field": "verified",
                "kind": "dimension",
                "physical_type": "boolean",
                "description": "Whether the club is verified (DetailedClub.verified).",
                "semantic_hints": [
