{
  "name": "@toorow/card-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Shared card chrome (CardShell) + card data contract on the Origin design system (Epic 9, Story 9.1). Title, freshness badge, rendered-comment slot with source affordance, definitions popover, slim footer.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./viz": "./src/viz/index.ts"
  },
  "scripts": {
    "generate:build-identity": "node scripts/generate-build-info.mjs && node scripts/emit-renderer-builds.mjs",
    "prebuild": "node scripts/generate-build-info.mjs && node scripts/emit-renderer-builds.mjs",
    "build": "node scripts/build-viz.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@toorow/shell": "workspace:*",
    "d3-hierarchy": "^3.1.2",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
