# Admin console environment variables (Story 2.4, T4.3)
# Copy to .env.local and fill in values for local dev.

# Nango public key — safe to expose to the frontend (Nango OSS design).
# The secret key (NANGO_SECRET_KEY) is server-only and MUST NOT appear here.
VITE_NANGO_PUBLIC_KEY=your-nango-public-key

# Nango server base URL (default: http://localhost:3003 for local dev)
VITE_NANGO_BASE_URL=http://localhost:3003
