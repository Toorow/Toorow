{
  "name": "@toorow/ui",
  "private": true,
  "version": "0.1.0",
  "description": "toorow UI workspace root (pnpm). Widgets build to single self-contained HTML files (AD-11).",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:tokens": "node tokens/style-dictionary.config.js",
    "build:sample": "pnpm --filter @toorow/widget-sample build",
    "bundle-check": "node scripts/bundle-check.mjs widgets/sample/dist/index.html",
    "bundle-check:widget": "node scripts/bundle-check.mjs widgets/sample/dist/index.html --max-bytes 1500000",
    "bundle-check:admin": "node scripts/bundle-check.mjs admin/dist/index.html --max-bytes 3000000"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  }
}
