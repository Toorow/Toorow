{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "origin": {
    "accent": {
      "primary": { "$type": "color", "$value": "#FF99C8", "$description": "Rose toorow — ONE accent, all interactive chrome" },
      "primary-hover": { "$type": "color", "$value": "#F77FB4", "$description": "Hover state of primary accent" },
      "on-primary": { "$type": "color", "$value": "#111111", "$description": "Text on accent background" },
      "decorative-purple": { "$type": "color", "$value": "#D1C4E9", "$description": "Lavande pastel — decorative gradients only, NEVER interactive" }
    },
    "neutral": {
      "text": { "$type": "color", "$value": "#111111", "$description": "Brand black — never pure #000" },
      "text-secondary": { "$type": "color", "$value": "#6B6A74", "$description": "Muted secondary text" },
      "text-on-dark": { "$type": "color", "$value": "#FAFAFA", "$description": "Light text on dark surfaces" },
      "surface-dark": { "$type": "color", "$value": "#121212", "$description": "Dark surface backgrounds" },
      "surface-dark-elevated": { "$type": "color", "$value": "#1E1E1E", "$description": "Elevated dark surface (cards)" },
      "surface-light": { "$type": "color", "$value": "#FFFFFF", "$description": "Light surface (cards)" },
      "background-light": { "$type": "color", "$value": "#F8F9FA", "$description": "Light page background (toorow)" },
      "divider-base": { "$type": "color", "$value": "#EBEBF3", "$description": "Base neutral tint — use at .08/.12/.30/1 opacity" },
      "divider-subtle": { "$type": "color", "$value": "#EBEBF314", "$description": "#EBEBF3 at opacity .08" },
      "divider-light": { "$type": "color", "$value": "#EBEBF31F", "$description": "#EBEBF3 at opacity .12" },
      "divider-medium": { "$type": "color", "$value": "#EBEBF34D", "$description": "#EBEBF3 at opacity .30" }
    },
    "semantic": {
      "error": { "$type": "color", "$value": "#D64550", "$description": "Framboise — accessible sur fond clair" },
      "on-error": { "$type": "color", "$value": "#FFFFFF" },
      "error-container": { "$type": "color", "$value": "#FFD6DB", "$description": "Conteneur pastel erreur" },
      "warning": { "$type": "color", "$value": "#E8A13D", "$description": "Ambre doux" },
      "on-warning": { "$type": "color", "$value": "#111111" },
      "warning-container": { "$type": "color", "$value": "#FCE8CD", "$description": "Conteneur pastel warning" },
      "success": { "$type": "color", "$value": "#3E9B6E", "$description": "Vert sauge — accessible sur fond clair" },
      "on-success": { "$type": "color", "$value": "#FFFFFF" },
      "success-container": { "$type": "color", "$value": "#CDEBDD", "$description": "Conteneur pastel succès" },
      "info": { "$type": "color", "$value": "#7E6BC4", "$description": "Lavande profonde" },
      "on-info": { "$type": "color", "$value": "#FFFFFF" },
      "info-container": { "$type": "color", "$value": "#D1C4E9", "$description": "Conteneur pastel info" }
    },
    "typography": {
      "font-family-primary": { "$type": "string", "$value": "\"Plus Jakarta Sans Variable\", \"Plus Jakarta Sans\", sans-serif", "$description": "Corps de texte & tableaux (toorow)" },
      "font-family-display": { "$type": "string", "$value": "\"Lexend Variable\", \"Lexend\", sans-serif", "$description": "Titres & logo (toorow)" },
      "font-family-numeric": { "$type": "string", "$value": "\"Geist Variable\", \"Geist\", \"Plus Jakarta Sans\", sans-serif", "$description": "Chiffres métier / montants / dates / axes — tabular (Geist, confirmé Jean 2026-07-24 pour la lisibilité). JAMAIS pour le texte." },
      "font-family-mono": { "$type": "string", "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", monospace", "$description": "IDs techniques / traces / versions immuables (JAMAIS un substitut de texte)" },
      "h1-size": { "$type": "dimension", "$value": "30px", "$description": "Page title (mockup validé) — recalé de 44px (valeur non validée visuellement)" },
      "h1-weight": { "$type": "number", "$value": 800, "$description": "Titres extra-bold — alignés sur le poids du logo (Jean 2026-07-24)" },
      "h1-letter-spacing": { "$type": "string", "$value": "-0.02em" },
      "h2-size": { "$type": "dimension", "$value": "20px", "$description": "Section title (mockup validé) — recalé de 32px" },
      "h2-weight": { "$type": "number", "$value": 800, "$description": "Titres de section extra-bold — alignés sur le logo" },
      "h3-size": { "$type": "dimension", "$value": "16px" },
      "h3-weight": { "$type": "number", "$value": 600 },
      "body-size": { "$type": "dimension", "$value": "15px" },
      "body-line-height": { "$type": "number", "$value": 1.6 },
      "body-weight": { "$type": "number", "$value": 400 },
      "caption-size": { "$type": "dimension", "$value": "12px" },
      "caption-weight": { "$type": "number", "$value": 400 },
      "numeric-variant": { "$type": "string", "$value": "lining-nums tabular-nums" }
    },
    "shape": {
      "radius": { "$type": "dimension", "$value": "12px" },
      "radius-small": { "$type": "dimension", "$value": "6px" },
      "radius-large": { "$type": "dimension", "$value": "16px" },
      "radius-pill": { "$type": "dimension", "$value": "999px", "$description": "Boutons et chips pill" }
    },
    "spacing": {
      "card-padding": { "$type": "dimension", "$value": "24px" },
      "section-gap": { "$type": "dimension", "$value": "32px" },
      "row-height": { "$type": "dimension", "$value": "52px" }
    },
    "shadow": {
      "card-light": { "$type": "string", "$value": "0 1px 4px rgba(17,17,17,0.04), 0 1px 2px rgba(17,17,17,0.03)", "$description": "Surfaces plates (réf.) — séparation par contraste de fond, ombre minimale" },
      "card-dark": { "$type": "string", "$value": "0 2px 16px rgba(0,0,0,0.4)" }
    },
    "viz": {
      "categorical-1": { "$type": "color", "$value": "#FF99C8", "$description": "Categorical series 1 — primary accent (Epic 9 card rule c: no per-component hex)" },
      "categorical-2": { "$type": "color", "$value": "#7E6BC4", "$description": "Categorical series 2 — lavande profonde" },
      "categorical-3": { "$type": "color", "$value": "#67C2A5", "$description": "Categorical series 3 — menthe" },
      "categorical-4": { "$type": "color", "$value": "#F6BD60", "$description": "Categorical series 4 — abricot" },
      "categorical-5": { "$type": "color", "$value": "#5CA8D8", "$description": "Categorical series 5 — bleu doux" },
      "categorical-6": { "$type": "color", "$value": "#E88C7D", "$description": "Categorical series 6 — corail, donut 'Autres' tail" },
      "track-light": { "$type": "color", "$value": "#EBEBF3", "$description": "Bar/gauge track in light mode — alpha .10 in dark (BarChart)" }
    }
  }
}
