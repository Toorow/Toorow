# toorow — environment variable reference
# Copy this file to .env and fill in values for local dev / manual QA.
# Never commit a filled-in .env to version control.

# ---------------------------------------------------------------------------
# Server port (injected by Cloud Run; default 8000 for local dev)
# ---------------------------------------------------------------------------
PORT=8000

# ---------------------------------------------------------------------------
# Host-header guard (Story 1.1, T3.2)
# ---------------------------------------------------------------------------
HOST_HEADER_VALIDATION=strict
ALLOWED_HOST=localhost:8000

# ---------------------------------------------------------------------------
# Auth mode (Story 2.3, AD-14)
#
# TOOROW_AUTH_MODE accepts exactly one of:
#   disabled  - no auth; the server logs a WARNING on startup; use for in-process
#               tests and local dev only (never in production)
#   static    - static token map; use for manual QA, smoke tests, and P3-dev
#   oauth     - JWT/RS256 verifier; required for Cloud Run production
# ---------------------------------------------------------------------------
# Default is 'static' so that a fresh clone requires a deliberate token before
# exposing the server to any network.  Switch to 'disabled' for unit tests /
# offline dev (the server will warn you it is running unauthenticated).
TOOROW_AUTH_MODE=static

# --- Static mode vars (required when TOOROW_AUTH_MODE=static) ---
TOOROW_STATIC_TOKEN=CHANGE_ME_use_a_long_random_string
# TOOROW_STATIC_SUBJECT=default-user

# --- OAuth mode vars (required when TOOROW_AUTH_MODE=oauth) ---
# Exactly one of TOOROW_JWT_PUBLIC_KEY or TOOROW_JWKS_URI must be set.
# If using a PEM file, collapse newlines to literal \n when pasting here.
# TOOROW_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----
# TOOROW_JWKS_URI=https://your-auth-server.example.com/.well-known/jwks.json
# TOOROW_JWT_ISSUER=https://your-auth-server.example.com/
# TOOROW_JWT_AUDIENCE=connector-api

# ---------------------------------------------------------------------------
# FastMCP native host/origin guard (complementary to the middleware above)
# ---------------------------------------------------------------------------
# FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=true
# FASTMCP_HTTP_ALLOWED_HOSTS=your-service.run.app

# ---------------------------------------------------------------------------
# Platform Postgres DB (Story 2.6, AD-8 -- audit_log owner)
#
# PLATFORM_DB_URL is the connection string for the platform Postgres instance
# defined in infra/nango/docker-compose.yml (service: platform-db).
# Set this for local dev and integration tests. In CI, leave it unset to skip
# DB integration tests automatically (they use pytest.mark.skipif on this var).
#
# Default (matches docker-compose.yml platform-db service):
#   postgresql://connector:connector_dev_only@localhost:5432/connector
#
# The PLATFORM_DB_PASSWORD var is used only as a fallback when PLATFORM_DB_URL
# is not set; it defaults to the docker-compose dev-only value.
# ---------------------------------------------------------------------------
PLATFORM_DB_URL=postgresql://connector:connector_dev_only@localhost:5432/connector
# PLATFORM_DB_PASSWORD=connector_dev_only  # used only when PLATFORM_DB_URL is unset

# ---------------------------------------------------------------------------
# GA4 Data API pull trigger (Story 2.7, AC2)
#
# GA4_PROPERTY_ID is your GA4 property numeric ID (e.g. 123456789).
# Used by the manual pull trigger endpoint (POST /api/connections/{id}/pull).
# Find it in Google Analytics Admin > Property Settings > Property ID.
# ---------------------------------------------------------------------------
# GA4_PROPERTY_ID=

# ---------------------------------------------------------------------------
# GA4 Measurement Protocol — OPTIONAL server-side product telemetry.
#
# Leave BOTH unset (the default) and the app measures nothing — a self-hosted
# instance never phones home. The maintainers set these only in their hosted
# deployment. If you set your own, events go to YOUR GA4 property, never ours.
# See infra/docs/tracking-and-consent.md.
#   GA4_MP_MEASUREMENT_ID : the web data stream measurement id (G-XXXXXXX).
#   GA4_MP_API_SECRET     : a secret created IN that same data stream
#                           (GA4 Admin > Data Streams > web > Measurement
#                            Protocol API secrets).
# ---------------------------------------------------------------------------
# GA4_MP_MEASUREMENT_ID=
# GA4_MP_API_SECRET=

# ---------------------------------------------------------------------------
# Story 3.2 -- Queue abstraction
#
# QUEUE_BACKEND: "local" (default) uses a Postgres-backed job table + daemon
# thread worker. "cloud_tasks" activates the Cloud Tasks backend (Phase B only).
#
# QUEUE_POLL_INTERVAL_SECONDS: how often the local worker polls for queued jobs.
# QUEUE_MAX_ATTEMPTS: dead-letter threshold (default 3).
# QUEUE_WORKER_ENABLED: set to "false" in CI / tests to suppress the thread.
#
# Cloud Tasks backend (QUEUE_BACKEND=cloud_tasks, Phase B only):
#   All four vars below are required when QUEUE_BACKEND=cloud_tasks.
# ---------------------------------------------------------------------------
QUEUE_BACKEND=local          # "local" (default) or "cloud_tasks"
QUEUE_POLL_INTERVAL_SECONDS=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_WORKER_ENABLED=true    # set to false in CI
# Cloud Tasks backend (QUEUE_BACKEND=cloud_tasks, Phase B only):
# CLOUD_TASKS_PROJECT=
# CLOUD_TASKS_LOCATION=
# CLOUD_TASKS_QUEUE_NAME=
# CLOUD_TASKS_WORKER_URL=

# ---------------------------------------------------------------------------
# Story 3.3 -- Quota engine
#
# QUEUE_MAX_BACKOFF_SECONDS: cap for exponential backoff when the quota
# engine blocks a job (breaker open or budget exhausted). Default 300s.
# ---------------------------------------------------------------------------
QUEUE_MAX_BACKOFF_SECONDS=300

# ---------------------------------------------------------------------------
# Story 3.4 -- Nightly scheduler
#
# SCHEDULER_ENABLED: set "true" to activate the in-process nightly thread.
#   Default "false" -- safe for CI and unit tests (HG-5).
# SCHEDULER_NIGHTLY_HOUR: local hour (0-23) to fire. Default 2.
# SCHEDULER_NIGHTLY_MINUTE: local minute (0-59) to fire. Default 0.
# SCHEDULER_TIMEZONE: IANA timezone the scheduler computes "yesterday" and the
#   briefing_date in. Default "Europe/Paris" (FR4). AI-26: set this EXPLICITLY
#   on any UTC server (Cloud Run, Phase B) -- otherwise a 02:00 UTC fire would
#   compute the wrong local "yesterday" around midnight.
#
# Local dev (Windows/Linux/macOS): set SCHEDULER_ENABLED=true to run the
# daemon thread. No cron, Task Scheduler, or external tool required.
#
# Production (GCP, Phase B -- QUEUE_BACKEND=cloud_tasks only):
# Cloud Scheduler sends POST to /internal/scheduler/dispatch-nightly instead.
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false          # set true to activate the in-process nightly thread
SCHEDULER_NIGHTLY_HOUR=2         # local-time hour to fire (0-23)
SCHEDULER_NIGHTLY_MINUTE=0       # local-time minute to fire (0-59)
SCHEDULER_TIMEZONE=Europe/Paris  # IANA tz for "yesterday"/briefing_date (AI-26)
# Cloud Scheduler Phase B (QUEUE_BACKEND=cloud_tasks only):
# CLOUD_SCHEDULER_JOB_NAME=<name>
# CLOUD_SCHEDULER_SERVICE_URL=<Cloud Run URL>/internal/scheduler/dispatch-nightly

# ---------------------------------------------------------------------------
# Story 3.5 -- Populate verification
#
# VERIFICATION_PARTIAL_THRESHOLD: completeness_ratio below which a pull with
#   non-zero rows is considered 'partial' (instead of 'ok').  Must be in [0, 1].
#   Default 0.5 (< 50% of expected rows = partial).
#   A pull with 0 actual rows is always 'empty' regardless of this threshold.
# ---------------------------------------------------------------------------
VERIFICATION_PARTIAL_THRESHOLD=0.5   # ratio below which a pull is considered 'partial'

# ---------------------------------------------------------------------------
# Story 3.1 -- Airbyte extraction path
#
# AIRBYTE_BASE_URL: Airbyte REST API base URL.
#   Local dev (abctl): http://localhost:8000
#   Local dev (docker-compose): http://localhost:8001 (use if 8000 conflicts with server)
#   Phase B (GKE): http://airbyte-server.airbyte.svc.cluster.local:8001
#   No code changes required -- env-var only config switch.
#
# AIRBYTE_API_KEY: optional bearer token. Airbyte OSS local requires no auth.
#   Airbyte Cloud/Enterprise requires a key.
#
# AIRBYTE_TIMEOUT_SECONDS: HTTP timeout for AirbyteClient calls (default 30).
#
# See infra/airbyte/SETUP.md for local bring-up instructions and port conflict
# resolution with the existing Nango docker-compose stack.
# ---------------------------------------------------------------------------
AIRBYTE_BASE_URL=http://localhost:8000   # Story 3.1 -- set to GKE internal URL in Phase B
AIRBYTE_API_KEY=                          # empty for Airbyte OSS local (no auth required)
AIRBYTE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Story 3.6 -- Meta Ads
#
# META_ADS_AD_ACCOUNT_ID: Meta ad account id. Accepts either the raw digits
#   (e.g. 1234567890) or the 'act_'-prefixed form (act_1234567890) -- the
#   connector normalizes it to act_<digits> for the Graph API path. Used by
#   pull() when the ad_account_id parameter is not supplied.
# META_ADS_APP_ID: Meta App ID for OAuth (used by the Nango OAuth flow config).
# ---------------------------------------------------------------------------
META_ADS_AD_ACCOUNT_ID=    # digits (1234567890) or act_-prefixed (act_1234567890)
META_ADS_APP_ID=           # Meta App ID for OAuth

# ---------------------------------------------------------------------------
# Story 5.2 -- Infra alerting
#
# ALERTS_ENABLED: master switch (default "false" -- safe for CI, HG-5 equivalent).
#   Set "true" to enable the alert evaluator on the scheduler thread.
#
# ALERT_DEAD_LETTER_THRESHOLD: dead-letter count >= threshold fires alert (default 1).
# ALERT_MIRROR_LAG_THRESHOLD_SECONDS: mirror sync lag >= threshold fires alert (default 3600).
# ALERT_VERIFICATION_THRESHOLD: completeness_ratio < threshold triggers failure count (default 0.5).
# ALERT_HEALTH_POLLER_STALE_SECONDS: health poller staleness >= threshold fires alert (default 7200).
#
# ALERT_EMAIL_ENABLED: enable SMTP email channel (default "false").
# ALERT_EMAIL_TO: recipient email address.
# ALERT_EMAIL_FROM: sender email address (default toorow@example.com).
# ALERT_LINK_BASE_URL: base URL for alert links in emails (default http://localhost:5173).
#
# SMTP_HOST: SMTP server hostname (required for email channel).
# SMTP_PORT: SMTP server port (default 587).
# SMTP_USER: SMTP auth username (optional).
# SMTP_PASSWORD: SMTP auth password (optional).
#
# Local dev SMTP: use Mailpit or MailHog on port 1025 (no auth, no TLS):
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Story 5.3 -- Business threshold alerting
#
# BUSINESS_ALERTS_ENABLED: master switch for business threshold evaluator (default "false").
#   Set "true" to evaluate alert_definitions after nightly dbt run (HG-5 equivalent).
#   Only has effect when SCHEDULER_ENABLED=true (nightly scheduler must be running).
#
# ALERT_SEMANTIC_METRICS: comma-separated metric names that are semantic (ratio) metrics.
#   These metrics are queried from dbt semantic views (e.g. marts.semantic_cpa),
#   NOT from fact_daily_kpi (AD-4: ratios never stored).
#   Default: cpa,roas,ctr
#
# MIRROR_SYNC_TABLES: comma-separated table names for the governed mirror sync (Story 4.4).
#   Default: context_events,project_preferences,connection_ref_dim,alert_definitions
#   (alert_definitions added with zero code change to mirror_sync.py -- HG-8 proof)
# ---------------------------------------------------------------------------
BUSINESS_ALERTS_ENABLED=false
ALERT_SEMANTIC_METRICS=cpa,roas,ctr   # comma-separated; ratio metrics use semantic views
# MIRROR_SYNC_TABLES=context_events,project_preferences,connection_ref_dim,alert_definitions

# ---------------------------------------------------------------------------
# Story 5.4 -- Anomaly surveillance
#
# ANOMALY_ALERTS_ENABLED: master switch for anomaly evaluator (default "false").
#   Set "true" to evaluate anomalies_daily after nightly dbt run (HG-5 equivalent).
#   Only has effect when SCHEDULER_ENABLED=true (nightly scheduler must be running).
#
# ANOMALY_Z_THRESHOLD: z-score threshold for flagging anomalies (default 3.0).
#   |z| in [3.0, 5.0) -> severity: warning; |z| >= 5.0 -> severity: error.
#
# ANOMALY_BASELINE_WINDOW: trailing window in days for rolling stats (default 29).
#   29 preceding rows + current row = 30-day window. Passed to dbt as env_var.
#
# ANOMALY_SEED_DAY: day index (0-based, 0-89) for injected test anomaly in seed.
#   Default 75. Used by generate_seed.py for Story 5.4 testability (AI-09).
# ---------------------------------------------------------------------------
ANOMALY_ALERTS_ENABLED=false
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_BASELINE_WINDOW=29

# ---------------------------------------------------------------------------
# Story 5.1 -- OTel/Langfuse tracing (optional extra [tracing])
#
# TRACING_ENABLED: set "true" to enable OpenTelemetry spans exported to Langfuse.
#   Default "false" -- safe for CI and unit tests (no exporter built, no OTLP call).
#   Requires installing: uv sync --extra tracing
#
# TRACING_SAMPLE_RATE: head-based sample rate [0.0, 1.0]. Default 1.0 (all spans).
# OTEL_SERVICE_NAME: service name for spans. Default "connector".
#
# Langfuse config (required when TRACING_ENABLED=true):
#   LANGFUSE_PUBLIC_KEY: Langfuse project public key.
#   LANGFUSE_SECRET_KEY: Langfuse project secret key.
#   LANGFUSE_HOST: Langfuse server URL (default http://localhost:3004 for local).
#
# Story 5.5 (AC9): when TRACING_ENABLED=true, the submit_feedback MCP tool also
# sends a Langfuse score (user_feedback, value=1.0 or -1.0) on the same trace as
# the get_daily_report call (AD-13). Set all LANGFUSE_* vars for this to work.
# ---------------------------------------------------------------------------
TRACING_ENABLED=false
# TRACING_SAMPLE_RATE=1.0
# OTEL_SERVICE_NAME=connector
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3004

ALERTS_ENABLED=false
ALERT_DEAD_LETTER_THRESHOLD=1
ALERT_MIRROR_LAG_THRESHOLD_SECONDS=3600
ALERT_VERIFICATION_THRESHOLD=0.5
ALERT_HEALTH_POLLER_STALE_SECONDS=7200
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=toorow@example.com
ALERT_LINK_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Story 6.1 -- Report pack framework + Epic 5 carry-forwards
#
# ALERT_TIMEOUT_SECONDS (AI-32): per-step timeout for each nightly piggyback step
#   (dispatch_nightly + the three alert checks). Default 60. A step exceeding this
#   is logged + meta-alerted; the remaining steps still run (failure isolation).
#
# FEEDBACK_RATE_LIMIT_PER_HOUR (AI-36): per-project in-memory rate limit on the
#   submit_feedback MCP tool. Default 60 calls/hour per project. The 61st call in
#   the window returns ToolError(code='rate_limited').
#
# ALERT_FIRING_COOLDOWN_DAYS (AI-33): NOT SET by default = daily reminders (one
#   firing per morning while a breach persists). Set to N to suppress a firing
#   when one already exists in the last N window_dates for the same definition.
#   See the AI-33 product-decision comment in server/core/business_alerts.py.
# ---------------------------------------------------------------------------
ALERT_TIMEOUT_SECONDS=60
FEEDBACK_RATE_LIMIT_PER_HOUR=60
# ALERT_FIRING_COOLDOWN_DAYS=   # unset = daily reminders (default)

# ---------------------------------------------------------------------------
# Story 7.2 -- Per-project module on/off
#
# MODULE_DEFAULT_ENABLED: controls behaviour when no row exists in
#   app.project_modules for a (project_id, module_name) pair.
#   "true"  (default) -- module is ENABLED by default. P3-dev compatible:
#           all discovered modules are available unless explicitly disabled.
#           Use this for single-project setups and local dev.
#   "false"           -- module is DISABLED by default (opt-in / agency mode).
#           Requires explicit app.project_modules rows to enable each module.
#           Use this for multi-client agency deployments (Phase B).
#
# Decision (Story 7.2 Dev Notes): default-enabled is the correct choice for
# P3-dev because the existing code + tests assume all discovered modules are
# available. Flipping to opt-in without seeding project_modules rows would
# break all existing behaviour and tests. Change to "false" when the first
# real agency deployment occurs.
# ---------------------------------------------------------------------------
MODULE_DEFAULT_ENABLED=true   # set to false for opt-in agency mode (Phase B)

# ---------------------------------------------------------------------------
# Story 7.3 -- Per-tenant encryption key backend
#
# TENANT_KEY_BACKEND: selects the key storage backend.
#   'local'          (default, Phase A) -- keys stored as files in TENANT_KEY_DIR.
#                    Suitable for local dev and single-server P3-dev deployments.
#                    Key material lives in infra/keys/<project_id>.key (gitignored).
#   'secret_manager' (Phase B -- requires HG-A: GCP billing account + Secret Manager
#                    API enabled). One-line switch once GCP is provisioned.
#
# TENANT_KEY_DIR: directory for Phase A local key files (default: infra/keys).
#   Relative paths resolve from the server working directory; use absolute paths
#   in production. The directory is gitignored -- never commit key files.
#
# Key scope (P3-dev honesty): the per-tenant key governs which rows in
#   app.tenant_key_audit are purged on revocation and proves the lifecycle
#   plumbing. The actual OAuth tokens live in Nango's own store under Nango's
#   global NANGO_ENCRYPTION_KEY (AD-3). The key isolation layer protects
#   cached metadata (connection health, module names) -- not the OAuth tokens.
# ---------------------------------------------------------------------------
TENANT_KEY_BACKEND=local       # 'local' (Phase A) or 'secret_manager' (Phase B -- HG-A)
TENANT_KEY_DIR=infra/keys      # Phase A only; ignored when TENANT_KEY_BACKEND=secret_manager

# ---------------------------------------------------------------------------
# Stories 18.1-18.4 -- Google direct OAuth (AD-21)
#
# Web OAuth client from the GCP project (console > APIs & Services > Credentials
# > OAuth client ID > Web application). The redirect URI registered on the
# client MUST match GOOGLE_OAUTH_REDIRECT_URI exactly.
#   Local dev: http://localhost:8000/api/google/oauth/callback
#   Phase B:   https://<cloud-run-url>/api/google/oauth/callback
#
# GOOGLE_OAUTH_STATE_SECRET: HMAC key signing the anti-CSRF state. REQUIRED
#   when TOOROW_AUTH_MODE is 'static' or 'oauth' (F-1 hard-fail). Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ADMIN_CONSOLE_OAUTH_RETURN: console path the callback redirects to. Must
#   start with '/' (open-redirect defense F-5). Default: /console/connections
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>   # jamais de vraie valeur ici -- .env only
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
# GOOGLE_OAUTH_STATE_SECRET=
# ADMIN_CONSOLE_OAUTH_RETURN=/console/connections

# ---------------------------------------------------------------------------
# Services externes provisionnes le 2026-07-19 (setup front/infra)
#
# Supabase : plateforme Postgres (remplace le docker-compose local a terme).
#   PLATFORM_DB_URL (section serveur ci-dessus) prend la connection string
#   session-pooler ; le mot de passe DB s'URL-encode ($ -> %24, # -> %23).
#   MCP : .mcp.json pointe https://mcp.supabase.com/mcp?project_ref=<ref>.
#
# Nango Cloud : providers non-Google (AD-3). Le serveur lit NANGO_BASE_URL /
#   NANGO_SECRET_KEY (defaut localhost:3003 = self-host docker infra/nango).
#   Callback OAuth cloud : https://api.nango.dev/oauth/callback
#
# Klaviyo : cle privee (pk_...) pour le futur connecteur Epic 15 ; le site
#   marketing n'embarque QUE le company ID public (web/.env PUBLIC_KLAVIYO_COMPANY_ID).
#
# Sanity : CMS du site marketing (web/ Astro + studio/). Le projet/dataset sont
#   publics (aussi dans web/.env) ; un token API n'est requis que pour ecrire.
# ---------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_DB_PASSWORD=<db-password>
# NANGO_BASE_URL=https://api.nango.dev
# NANGO_SECRET_KEY=<nango-secret-key>
# KLAVIYO_API_KEY=pk_<...>
# KLAVIYO_COMPANY_ID=<public-site-id>
# SANITY_PROJECT_ID=<project-id>
# SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Story 19.1 -- Cache local DuckDB read-through (CAP-22 / AD-22)
#
# Le cache est un INSTANTANE ephemere des marts recents, servi a ~50 ms sans scan
# BigQuery (le routage read-through arrive en 19.2). C'est un artefact PROD DISTINCT
# du warehouse dev : ne JAMAIS confondre cache_warehouse.duckdb (ce cache) avec
# local.duckdb (TOOROW_DUCKDB_PATH -- la verite en dev).
#
# TOOROW_CACHE_ENABLED : interrupteur (defaut "false" -- prudent). Le service
#   tourne SANS cache (l'absence de cache = degradation de latence, jamais une
#   erreur). Mettre "true" pour activer le rebuild post-nightly + on-demand.
# TOOROW_CACHE_PATH : chemin du fichier cache (defaut "cache_warehouse.duckdb").
#   DOIT etre distinct de TOOROW_DUCKDB_PATH.
# TOOROW_CACHE_WINDOW_DAYS : fenetre glissante en jours (defaut 30). L'export
#   filtre date >= today-(N-1) ET project_id (AD-5). NOTE spec F3 Phase B : la
#   fenetre est actuellement GLOBALE (meme valeur pour tous les projets). La
#   configurabilite PAR PROJET est reportee en Phase B : chaque projet pourrait
#   avoir sa propre fenetre via une config scoped (memotech : direction generale
#   "preferences par projet, pas de hardcode plateforme"). Ne pas implementer ici.
# TOOROW_CACHE_TABLES : allowlist declarative (CSV). Defaut deduit des lectures
#   REELLEMENT routees par warehouse.py (spec F4 dette tranchee en 19.4) :
#     fact_daily_kpi                   <- query_daily_report, query_report (additif)
#     semantic_ctr                     <- query_report (non-additif, metric=ctr)
#     semantic_cpa                     <- query_report (non-additif, metric=cpa)
#     semantic_roas                    <- query_report (non-additif, metric=roas)
#     semantic_avg_position            <- query_report (non-additif, metric=average_position)
#                                         [spec F4 DETTE TRANCHEE 19.4 : le routeur
#                                         mappe desormais average_position ->
#                                         semantic_avg_position via
#                                         _SEMANTIC_VIEW_BY_METRIC, alignement avec
#                                         business_alerts.py G-03 fix]
#     semantic_avg_position_composite  <- query_composite_positions (Story 10.5)
#     dedup_estimate                   <- query_dedup_estimate (Epic 17)
#     transaction_reconciliation_daily <- query_transaction_reconciliation_daily (17.4)
#
#   EXCLUSIONS documentees :
#     semantic_average_position : ce nom n'est PLUS jamais construit par le routeur
#       (spec F4 dette soldee en 19.4 : _SEMANTIC_VIEW_BY_METRIC redirige vers
#       semantic_avg_position). Aucune entree dans l'allowlist n'est necessaire.
#   Ajouter une table = une ligne de config, pas du code.
#
# En prod l'origine est BigQuery (TOOROW_DB_MODE=bigquery) ; le chemin extract
# reel est Phase B (AI-08), BLOCKED. En dev l'origine est deja local.duckdb : le
# builder se teste par simulation origin-duckdb -> cache-duckdb.
# ---------------------------------------------------------------------------
TOOROW_CACHE_ENABLED=false          # set true to build the read-through cache
# TOOROW_CACHE_PATH=cache_warehouse.duckdb
# TOOROW_CACHE_WINDOW_DAYS=30       # NOTE Phase B : par-projet = direction cible,
#                                      # pas encore implemente (spec F3 Phase B).
# TOOROW_CACHE_TABLES=fact_daily_kpi,semantic_ctr,semantic_cpa,semantic_roas,semantic_avg_position,semantic_avg_position_composite,dedup_estimate,transaction_reconciliation_daily
#
# TOOROW_CACHE_TTL_SECONDS : plafond TTL (defaut 26h -- une cadence nightly +
#   marge). Introduit en 19.2 (warehouse.py _cache_is_fresh). Meme si l'ancre
#   nightly ne peut pas etre calculee (tz db manquante), un cache trop vieux est
#   bypasse. Ajuster si la cadence nightly change. NOTE perf F-5 : sur de grosses
#   volumetries avec des marts qui mettent plus d'une heure a se reconstruire,
#   augmenter TOOROW_CACHE_TTL_SECONDS pour eviter un bypass prematuro entre
#   la fin du nightly et la fin du rebuild cache (ALERT_TIMEOUT_SECONDS du
#   scheduler peut aussi etre augmente en consequence).
# TOOROW_CACHE_TTL_SECONDS=93600
