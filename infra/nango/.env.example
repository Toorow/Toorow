# infra/nango/.env.example
#
# Copy this file to infra/nango/.env and fill in the values.
# .env is gitignored — never commit secrets.
#
# Usage:
#   cp infra/nango/.env.example infra/nango/.env
#   # Edit .env with your dev values, then:
#   docker compose -f infra/nango/docker-compose.yml up -d

# ---------------------------------------------------------------------------
# Nango encryption key
# Dev: generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Prod: sourced from GCP Secret Manager (secret: nango-encryption-key)
# ---------------------------------------------------------------------------
NANGO_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Nango server URL
# Dev:  http://localhost:3003
# Prod: Cloud Run service URL (no code changes needed — config-only migration)
# ---------------------------------------------------------------------------
NANGO_SERVER_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# Nango secret key for server-to-server API calls
# Dev:  found in Nango UI -> Settings -> Secret Key (after first startup)
# Prod: sourced from GCP Secret Manager (secret: nango-secret-key)
# ---------------------------------------------------------------------------
NANGO_SECRET_KEY=

# ---------------------------------------------------------------------------
# Nango base URL (same as NANGO_SERVER_URL; used by server/core/nango_client.py)
# ---------------------------------------------------------------------------
NANGO_BASE_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# Nango internal Postgres password (dev only; not used in prod Cloud SQL path)
# ---------------------------------------------------------------------------
NANGO_DB_PASSWORD=nango_dev_only

# ---------------------------------------------------------------------------
# Google OAuth client credentials
# Dev:  create a free-tier GCP project OAuth client (see infra/nango/README.md)
#       No billing account required.
# Prod: sourced from GCP Secret Manager (secret: google-oauth-client-id / google-oauth-client-secret)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Platform Postgres connection URL
# Dev:  docker-compose platform-db service (host port 5432)
# Prod: Cloud SQL connection string via Secret Manager
# ---------------------------------------------------------------------------
PLATFORM_DATABASE_URL=postgresql://connector:connector_dev_only@localhost:5432/connector

# Platform Postgres password (used by docker-compose)
PLATFORM_DB_PASSWORD=connector_dev_only

# ---------------------------------------------------------------------------
# Integration test flag
# Set to 1 to run tests that require Nango to be running (docker-compose up)
# ---------------------------------------------------------------------------
NANGO_INTEGRATION_TESTS=
